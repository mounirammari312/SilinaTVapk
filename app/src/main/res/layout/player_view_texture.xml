<?xml version="1.0" encoding="utf-8"?>
<!--
  Ported from the reference app (V3.6.2): PlayerView with TextureView
  surface type.

  CRITICAL: a SurfaceView creates a separate hardware plane that
  composites ABOVE the app's UI surface. A full-screen VLCVideoLayout
  stacked over the PlayerView therefore paints its internal (opaque,
  empty) SurfaceView ON TOP of ExoPlayer's video surface — the user
  sees a BLACK screen while the audio keeps playing (and a brief
  flash of video when the surfaces are torn down on exit).

  TextureView renders on the app's UI surface instead: no z-order
  conflicts, and ALL Compose overlays (buffering spinner, controls,
  zap overlay) are always drawn ON TOP of the video.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:resize_mode="fit"
    app:use_controller="false"
    app:shutter_background_color="@android:color/black"
    app:surface_type="texture_view" />
