    <path
        android:fillColor="#fff"
        android:pathData="M8.3,1.5 h2.4 v6.7 h3.3 l-4.5,4.8 -4.5,-4.8 h3.3 z"/>
    <!-- tray -->
    <path
        android:fillColor="#fff"
        android:pathData="M3.4,17.0 h17.2 c0.75,0 1.35,0.6 1.35,1.35 v0.3 c0,0.75 -0.6,1.35 -1.35,1.35 h-17.2 c-0.75,0 -1.35,-0.6 -1.35,-1.35 v-0.3 c0,-0.75 0.6,-1.35 1.35,-1.35 z"/>
    <!-- play badge (circle with a play-triangle cutout) -->
    <path
        android:fillColor="#fff"
        android:fillType="evenOdd"
        android:pathData="M17.2,8.2 a4.6,4.6 0 1 0 0,9.2 a4.6,4.6 0 1 0 0,-9.2 z M15.6,10.6 v4.4 l4.4,-2.2 z"/>
