<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ═══════════════════════════════════════════════════════════════
         SPLASH THEME — No launcher icon, direct to background.
         Uses windowBackground = black so the app opens directly to a
         black screen (no system launcher icon flash) before the
         SplashActivity composable loads its background image.
         ═══════════════════════════════════════════════════════════════ -->
    <style name="SilinaSplashTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- Fullscreen, no-status-bar theme applied at Activity-level on top of Material base.
         Used together with applyImmersiveFullscreen() at runtime for edge-to-edge behavior. -->
    <style name="SilinaFullscreenTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
