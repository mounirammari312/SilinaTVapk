<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- v1.5.0 — General Settings' "AutoStart On Boot UP" (VuBootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- v2.0.0 — the panel's FCM notifications on Android 13+ (asked once at
         launch, MainActivity requestPermissions(4701); TV boxes < API 33 skip). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v2.0.0 — the panel's in-app APK updater (UpdateCenter → DownloadManager
         → FileProvider → ACTION_VIEW installer). Granted through the one-time
         "install unknown apps" screen, never silently. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Runs on TV boxes too (no touchscreen required) -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".IPTVApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.IPTVPlayer">

        <!-- Installs the crash handler BEFORE any library startup provider runs -->
        <provider
            android:name=".diagnostics.CrashProvider"
            android:authorities="${applicationId}.crash-provider"
            android:exported="false" />

        <!-- v2.0.0 — serves the panel-update APK from the app's external files
             dir to the system installer (UpdateCenter.openInstaller). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.update_provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <!-- v2.0.0 — FCM push display (OriaMessagingService). Background/killed
             notification payloads use the default channel below; foreground
             messages are shown by the service itself. -->
        <service
            android:name=".data.remote.OriaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="oria_general" />

        <!-- View-based crash report viewer (no Compose — must survive UI-layer crashes) -->
        <activity
            android:name=".diagnostics.CrashReportActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.IPTVPlayer" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|locale|layoutDirection|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Also appears in Android TV launchers -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- v1.5.0 — General Settings' "AutoStart On Boot UP": guarded by the
             stored preference (off by default — a no-op until enabled). -->
        <receiver
            android:name=".VuBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
